{
  "name": "dsh-chat-avatar",
  "version": "0.1.1",
  "description": "DSH Web 聊天头像插件：像 QQ/微信一样，给用户消息右侧加头像、AI 消息左侧加头像",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "avatars"
  ],
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "license": "MIT"
}
